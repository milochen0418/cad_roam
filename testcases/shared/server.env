# Signed-in people: the suite makes their sign-in cookies with this secret (any value, for the suite).
DDNS_AUTH_SECRET=shared-suite-secret-for-cad-roam-tests
# Profiles open in a dialog of Relack's; the suite checks what is asked of it, not Relack (nothing
# answers here).
DDNS_INTENT_URL_RELACK=http://127.0.0.1:9
